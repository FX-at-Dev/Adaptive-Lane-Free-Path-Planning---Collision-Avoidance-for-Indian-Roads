# Simulation and rendering outputs (regenerate with sih_run_all + tools/)
/results/*
# Match the CONTENTS, not the directory: git cannot re-include a file
# whose parent directory is excluded, and the finished brag video below
# has to be re-includable.
/brag-output/*
/brag-output-*/
!/brag-output/brag.mp4
!/brag-output/brag.jpg
!/brag-output/share-copy.txt

# Generated intermediate media
*.gif
*.avi
*.mov
*.wav
*.raw
.brag_ts

# Python and MATLAB/Octave local artifacts
__pycache__/
*.py[cod]
*.so
*.dll
*.mex*
*.mat
*.fig
*.asv
*.m~

# Local editor and operating-system files
.vscode/
.DS_Store
Thumbs.db

# Deck figures regenerated by ppt/build_deck.py
/ppt/build/

# SUBMISSION DELIVERABLES ARE TRACKED ON PURPOSE.
# These were destroyed once by `git clean -xfd` because a blanket *.pptx /
# *.pdf / *.mp4 ignore hid them from git. Keep them tracked so a clean cannot
# remove them. Negations must come last: the final matching pattern wins.
!/results/SIH26037_submission.mp4
!*.pptx
!*.pdf

# Office lock files (~$name), created while a document is open. This must
# stay AFTER the !*.pptx negation above: the last matching pattern wins, so
# placing it earlier let the negation re-include the lock file.
~$*
